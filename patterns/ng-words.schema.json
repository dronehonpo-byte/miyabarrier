{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://miyabarrier.dev/schema/ng-words.schema.json",
  "title": "Miyabarrier NG word list",
  "type": "object",
  "required": ["version", "categories"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "description": "YYYY-MM-DD" },
    "locale": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "score", "cap", "terms"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string" },
          "score": {
            "type": "number",
            "description": "1語ヒットごとの加点。負値は減点(正当な問い合わせらしさ)。"
          },
          "cap": {
            "type": "number",
            "description": "このカテゴリ単体の加点上限。score が負なら下限として扱う。符号は score と一致させる。"
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "部分一致で判定。小文字・半角で記述する。"
          },
          "patterns": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "JavaScript 正規表現のソース。フラグは gi 固定。"
          }
        }
      }
    },
    "allowlist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": { "type": "string" },
        "terms": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
